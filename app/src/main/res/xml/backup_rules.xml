<?xml version="1.0" encoding="utf-8"?>
<!-- Backups (Android 11 and older) keep only the budget and settings. Sign-in, Firebase's own
     stores and the sync cache stay on this phone, so a restore never brings back a signed-in session. -->
<full-backup-content>
    <include domain="sharedpref" path="budget.xml" />
    <include domain="sharedpref" path="settings.xml" />
</full-backup-content>
